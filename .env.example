# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/industrial_distributor

# Address that receives new order / enquiry notifications (required)
DISTRIBUTOR_EMAIL=owner@yourcompany.com

# Public site URL, used for metadata and canonical links (required in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email notifications via Resend (optional — logged to the console when unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Image uploads via Cloudinary (optional — /api/upload returns 503 when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved for authentication (not yet wired to protect routes)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Payments (optional — not yet implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
