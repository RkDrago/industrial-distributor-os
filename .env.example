[TEMPLATE]
# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/industrial_distributor

# Address that receives new order / enquiry notifications (required)
DISTRIBUTOR_EMAIL=owner@yourcompany.com

# Public site URL, used for metadata and canonical links (required in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email notifications via Resend (optional — logged to the console when unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Image uploads via Cloudinary (optional — /api/upload returns 503 when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public business details, shown in the footer, contact page and invoices.
# These are demonstration values — replace them with the distributor's real details.
NEXT_PUBLIC_COMPANY_NAME=Norgez Industrial
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=sales@yourcompany.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_GSTIN=

# Admin dashboard access (required to use /admin).
# ADMIN_SESSION_SECRET signs the admin session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ADMIN_EMAIL and ADMIN_PASSWORD also seed the first administrator into the
# database. That bootstrap only runs while the database holds no administrator
# at all, so it never overwrites an account you created later. Two ways it runs:
# automatically on the first request to /admin/login, or explicitly via `npm run seed`.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=use-a-long-unique-password
# Optional: bcrypt hash of the admin password. Takes priority over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Payments (optional — not yet implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
